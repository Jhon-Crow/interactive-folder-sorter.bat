@echo off
chcp 1251 >nul
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference = 'Stop'; try { $dirs = Get-ChildItem -Directory | Where-Object { $_.Name -match '^(\d+)\.\s*(.*)' }; if (-not $dirs) { exit }; $items = @(); foreach ($d in $dirs) { $null = $d.Name -match '^(\d+)\.\s*(.*)'; $items += [PSCustomObject]@{ FullName = $d.FullName; Number = [int]$matches[1]; Text = $matches[2]; CreationTime = $d.CreationTime; Name = $d.Name } }; $sorted = $items | Sort-Object Number, CreationTime; $final = @(); $i = 0; while ($i -lt $sorted.Count) { $c = $sorted[$i]; if ($i + 1 -lt $sorted.Count -and $sorted[$i+1].Number -eq $c.Number) { $n = $sorted[$i+1]; $w = [Console]::WindowWidth; if ($w -lt 80) { $w = 80 }; $name1 = $c.Name; $name2 = $n.Name; $maxLen = [math]::Floor($w / 2) - 10; if ($maxLen -lt 10) { $maxLen = 10 }; if ($name1.Length -gt $maxLen) { $name1 = $name1.Substring(0, $maxLen - 3) + '...' }; if ($name2.Length -gt $maxLen) { $name2 = $name2.Substring(0, $maxLen - 3) + '...' }; $leftPart = '[1] ' + $name1; $rightPart = $name2 + ' [2]'; $totalSpace = $w - $leftPart.Length - $rightPart.Length; if ($totalSpace -lt 4) { $totalSpace = 4 }; $gap = ' ' * $totalSpace; $leftArrow = '[ <-- Left ]'; $rightArrow = '[ Right --> ]'; $middle = '   |   '; $arrowStr = $leftArrow + $middle + $rightArrow; $arrowPad = [math]::Floor(($w - $arrowStr.Length) / 2); Write-Host ''; Write-Host '=== КОНФЛИКТ НОМЕРОВ: ' $c.Number ' ===' -ForegroundColor Yellow; Write-Host ''; Write-Host $leftPart -ForegroundColor Cyan -NoNewline; Write-Host $gap -NoNewline; Write-Host $rightPart -ForegroundColor Magenta; Write-Host ''; Write-Host (' ' * $arrowPad) -NoNewline; Write-Host $leftArrow -ForegroundColor Cyan -NoNewline; Write-Host $middle -ForegroundColor DarkGray -NoNewline; Write-Host $rightArrow -ForegroundColor Magenta; Write-Host ''; Write-Host ''; while ($true) { $key = [Console]::ReadKey($true); if ($key.Key -eq 'LeftArrow' -or $key.KeyChar -eq '1') { $final += $c; $final += $n; Write-Host ' -> Выбрано: [1] идет первой.' -ForegroundColor DarkGray; break } elseif ($key.Key -eq 'RightArrow' -or $key.KeyChar -eq '2') { $final += $n; $final += $c; Write-Host ' -> Выбрано: [2] идет первой.' -ForegroundColor DarkGray; break } }; $i += 2 } else { $final += $c; $i++ } }; $temp = @(); $cnt = 1; foreach ($f in $final) { $tName = 'TEMP_RENAME_' + $cnt; $temp += [PSCustomObject]@{ Temp = $tName; Text = $f.Text; FullName = $f.FullName }; Rename-Item -Path $f.FullName -NewName $tName -ErrorAction Stop; $cnt++ }; $cnt = 1; foreach ($t in $temp) { $fName = '{0:D2}. {1}' -f $cnt, $t.Text; Rename-Item -Path (Join-Path $PWD $t.Temp) -NewName $fName -ErrorAction Stop; $cnt++ } } catch { Write-Host 'Ошибка: ' $_.Exception.Message -ForegroundColor Red; pause }"